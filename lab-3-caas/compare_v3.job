#!/bin/bash
# Compares V2 (nonblocking) with the partner's V3 (cached subscriptions) on
# every grid (or line) size, same seed per shape. V3 is built here from its
# source unchanged (its Makefile.v3 does not find ../lab-3-common).
#   sbatch compare_v3.job grid       34 grid shapes, threshold 3
#   sbatch compare_v3.job line       30 line sizes, threshold 3
#   sbatch compare_v3.job grid 4     heavier congestion (threshold 4 of 6 ports)
# Output: results/v3cmp_<mode>_t<threshold>.csv
#SBATCH --job-name=wsn_v3cmp
#SBATCH --time=00:10:00
#SBATCH --mem=16G
#SBATCH --ntasks=32                  ### CAAS maximum: up to 31 nodes + base station
#SBATCH --cpus-per-task=1
#SBATCH --ntasks-per-node=16         ### 2 machines, so messages cross the network
#SBATCH --partition=defq

module load openmpi/4.1.5-gcc-11.2.0-ux65npg
# Idle OpenMP port threads sleep instead of spinning, so they do not steal the
# MPI thread's core (each MPI process is given 1 core).
export OMP_WAIT_POLICY=PASSIVE

MODE=${1:-grid}
THRESHOLD=${2:-3}
SEED=${SLURM_JOB_ID:-1}
COMMON_ARGS="--threshold $THRESHOLD --rounds 100 --interval-ms 10 --seed $SEED"
CSV=results/v3cmp_${MODE}_t${THRESHOLD}.csv
mkdir -p results logs

mpicc -std=c11 -O2 -fopenmp -I../lab-3-common ../lab-3-file-3/wsn_v3.c \
    ../lab-3-common/common.c -o ../lab-3-file-3/wsn_v3 || exit 1

SHAPES=()
if [ "$MODE" = "line" ]; then
    for n in $(seq 2 31); do SHAPES+=("1 $n"); done
else
    for m in 2 3 4 5; do
        for n in $(seq 2 15); do
            [ $((m * n)) -le 31 ] && SHAPES+=("$m $n")
        done
    done
fi

echo "mode=$MODE threshold=$THRESHOLD shapes=${#SHAPES[@]} seed=$SEED"
for shape in "${SHAPES[@]}"; do
    set -- $shape
    np=$(($1 * $2 + 1))
    for v in 2 3; do
        srun -n $np ../lab-3-file-$v/wsn_v$v $1 $2 $COMMON_ARGS \
            --log logs/v3cmp_${MODE}_t${THRESHOLD}_v${v}_${1}x${2}.log \
            --csv $CSV > /dev/null 2>&1 \
            || echo "FAILED: V$v ${1}x${2}"
    done
    echo "done ${1}x${2}"
done
