#!/bin/bash
# Quick functional check on CAAS (3x3 grid = 10 MPI processes).
# Submit from this folder:  sbatch smoke_test.job          (V1-V4)
#                           sbatch smoke_test.job 4        (only V4)
#SBATCH --job-name=wsn_smoke
#SBATCH --time=00:05:00
#SBATCH --mem=16G
#SBATCH --ntasks=10
#SBATCH --cpus-per-task=1
#SBATCH --ntasks-per-node=5          ### 2 machines, so messages cross the network
#SBATCH --partition=defq

module load openmpi/4.1.5-gcc-11.2.0-ux65npg
# Idle OpenMP port threads sleep instead of spinning, so they do not steal the
# MPI thread's core (each MPI process is given 1 core).
export OMP_WAIT_POLICY=PASSIVE

for v in ${1:-1 2 3 4}; do
    echo "===== V$v corner scenario (expect Node 0 -> Node 4) ====="
    srun -n 10 ../lab-3-file-$v/wsn_v$v 3 3 --scenario corner --rounds 3 \
        --interval-ms 200 --log smoke_v$v.log
    sed -n '/FINAL SUMMARY/,$p' smoke_v$v.log
done

# Memory check: see valgrind.job
